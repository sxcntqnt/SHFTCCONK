{
  "name": "FLAM",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6092 vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test_run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write --plugin prettier-plugin-svelte ./",
    "format_check": "prettier --check --plugin prettier-plugin-svelte ./",
    "postinstall": "patch-package",
    "prod-dev": "svelte-kit dev",
    "prod-build": "svelte-kit build",
    "prod-preview": "svelte-kit preview",
    "prod-start": "PORT=4173 node build",
    "wasm": "wasm-pack build --dev --target web ../backend",
    "auth:dev": "go run ../backend/auth/main.go",
    "chat:dev": "go run ../backend/chat/main.go",
    "services:dev": "concurrently \"pnpm auth:dev\" \"pnpm chat:dev\"",
    "auth:build": "go build -o auth ../backend/auth",
    "chat:build": "go build -o chat ../backend/chat",
    "auth:start": "../auth",
    "chat:start": "../chat",
    "services:prod": "pnpm auth:build && pnpm chat:build && concurrently \"pnpm auth:start\" \"pnpm chat:start\""
  },
  "type": "module",
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.1.1",
    "@sveltejs/kit": "^2.52.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/glob": "^8.1.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "cross-env": "^10.1.0",
    "daisyui": "^5.5.18",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-svelte": "^2.46.1",
    "fuse.js": "^7.1.0",
    "glob": "^10.5.0",
    "html-to-text": "^9.0.5",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "super-sitemap": "^1.0.7",
    "svelte": "^5.53.0",
    "svelte-check": "^4.4.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev20.0",
    "@duckdb/node-bindings": "1.5.0-r.1",
    "@grpc/grpc-js": "^1.14.3",
    "@hyperledger/fabric-gateway": "^1.10.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^0.574.0",
    "@melt-ui/svelte": "^0.86.6",
    "@sentry/sveltekit": "^10.40.0",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/auth-ui-svelte": "^0.2.9",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.97.0",
    "@sveltejs/adapter-node": "^5.5.3",
    "@threlte/core": "^8.4.0",
    "@threlte/extras": "^9.8.1",
    "@upstash/redis": "^1.36.2",
    "apache-arrow": "^21.1.0",
    "axios": "^1.13.5",
    "chart.js": "^4.5.1",
    "d3-scale": "^4.0.2",
    "fabric-ca-client": "^2.2.20",
    "firebase": "^12.11.0",
    "gsap": "^3.14.2",
    "h3-js": "^4.4.0",
    "handlebars": "^4.7.8",
    "idb": "^8.0.3",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "layerchart": "1.0.13",
    "maplibre-gl": "^5.19.0",
    "maplibre-gl-draw": "^1.6.9",
    "patch-package": "^8.0.1",
    "posthog-js": "^1.356.1",
    "posthog-node": "^5.26.0",
    "resend": "^3.5.0",
    "stripe": "^13.11.0",
    "three": "^0.183.1",
    "three-stdlib": "^2.36.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@supabase/auth-ui-svelte": {
      "svelte": "$svelte"
    },
    "@supabase/ssr": {
      "cookie": "^0.7.0"
    },
    "@sveltejs/kit": {
      "cookie": "^0.7.0"
    },
    "@humanwhocodes/config-array": "npm:@eslint/config-array@latest",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@latest",
    "glob": "^10.5.0",
    "rimraf": "^5.0.10",
    "inflight": "npm:promise-inflight@^1.0.1",
    "lodash.isequal": "^4.5.0"
  }
}