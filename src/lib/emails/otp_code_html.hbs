<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title>Your Matatu Pulse verification code</title>
</head>
<body style="margin:0; padding:0; background-color:#F3F4F6; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <!-- Preheader (hidden preview text) -->
  <div style="display:none; max-height:0; overflow:hidden; opacity:0;">
    Your Matatu Pulse verification code is {{code}}. It expires in {{expires_in_minutes}} minutes.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F3F4F6;">
    <tr>
      <td align="center" style="padding:32px 16px;">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:480px; background-color:#FFFFFF; border-radius:12px; overflow:hidden; border:1px solid #E5E7EB;">

          <!-- Header -->
          <tr>
            <td style="background-color:#0B7A3E; padding:24px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="font-size:18px; font-weight:700; color:#FFFFFF; letter-spacing:-0.2px;">
                    Matatu&nbsp;Pulse
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:32px;">
              <p style="margin:0 0 8px; font-size:15px; line-height:22px; color:#111827;">
                Here's your verification code:
              </p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0;">
                <tr>
                  <td align="center" style="background-color:#F3F4F6; border:1px solid #E5E7EB; border-radius:8px; padding:20px 16px;">
                    <span style="font-family:'SF Mono',SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace; font-size:32px; font-weight:700; letter-spacing:8px; color:#0B7A3E;">
                      {{code}}
                    </span>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 4px; font-size:14px; line-height:20px; color:#4B5563;">
                This code expires in <strong>{{expires_in_minutes}} minutes</strong> and can only be used once.
              </p>
              <p style="margin:16px 0 0; font-size:14px; line-height:20px; color:#4B5563;">
                If you didn't request this code, you can safely ignore this email — no changes will be made to your account.
              </p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 0; border-top:1px solid #E5E7EB;">
                <tr>
                  <td style="padding-top:16px; font-size:12px; line-height:18px; color:#9CA3AF;">
                    Never share this code with anyone. Matatu Pulse staff will never ask you for it.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:20px 32px; background-color:#F9FAFB; border-top:1px solid #E5E7EB;">
              <p style="margin:0; font-size:12px; line-height:18px; color:#9CA3AF; text-align:center;">
                Matatu Pulse &middot; Nairobi, Kenya
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>
